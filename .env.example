# Copy to .env and fill in. Nothing here is required: the defaults run fully offline.
# Most model settings can also be changed later in Admin -> Settings (keys are stored encrypted).

# --- Providers ---------------------------------------------------------------
# Answers: OpenRouter (free models), embeddings: Google Gemini (free AI Studio key).
LLM_PROVIDER=openai_compatible     # stub | gemini | openai_compatible
EMBED_PROVIDER=gemini              # hash | gemini | openai_compatible
STORE=local                        # local | supabase

# --- Answers: OpenRouter -----------------------------------------------------
# Key: https://openrouter.ai/keys   Free models end in ":free" (https://openrouter.ai/models).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
OPENAI_LLM_MODEL=openrouter/free   # free model ids change; pick a current one

# --- Embeddings: Gemini ------------------------------------------------------
# Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768                      # changing the embedding model needs a re-embed (Admin -> Data)

# --- Database (only when STORE=supabase) --------------------------------------
# Supabase -> Project Settings -> Database -> Connection pooling: use the pooler URI, not the direct host.
DATABASE_URL=
PG_CHECKPOINTER=false              # keep LangGraph conversation threads in Postgres

# --- Cache and rate limits ----------------------------------------------------
# Leave REDIS_URL empty for the in-process cache. Upstash free tier: rediss://default:<password>@<host>:6379
REDIS_URL=
CACHE_BACKEND=auto                 # auto | redis | memory | off
RATE_LIMIT=20/minute

# --- Accounts and admin ---------------------------------------------------------
# ADMIN_TOKEN is the one-time setup key for the first admin account (sign in -> "First-time admin setup").
# SECRET_KEY signs sessions and encrypts saved API keys. Keep it stable, or saved keys become unreadable.
ADMIN_TOKEN=
SECRET_KEY=
ALLOW_SIGNUP=true

# --- API ------------------------------------------------------------------------
ENVIRONMENT=dev                    # dev | production (production hides /docs and enables HSTS)
CORS_ORIGINS=http://localhost:3100,https://YOUR-APP.vercel.app
LOG_RETENTION_DAYS=90

# --- Observability (optional) ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
