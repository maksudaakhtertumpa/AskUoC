# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time.

# FastAPI backend URL as seen from the browser; also added to the CSP connect-src.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this web app, no trailing slash (canonical URLs, sitemap, robots, Open Graph, security.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Privacy/security contact shown in the privacy policy and security.txt; recommended for public deployments.
NEXT_PUBLIC_CONTACT_EMAIL=

# Data controller named in the privacy policy; defaults to the author's name.
NEXT_PUBLIC_OPERATOR_NAME=

# Public source repository, e.g. https://github.com/you/AskUoC (optional); enables source/licence/advisory links.
NEXT_PUBLIC_REPO_URL=

# Optional personal website to link the footer "Built by" credit to.
NEXT_PUBLIC_AUTHOR_URL=
